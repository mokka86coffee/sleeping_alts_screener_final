{"id": "bittensor", "symbol": "tao", "name": "Bittensor", "web_slug": "bittensor", "asset_platform_id": null, "platforms": {"": ""}, "detail_platforms": {"": {"decimal_place": null, "contract_address": ""}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Artificial Intelligence (AI)", "Smart Contract Platform", "Layer 1 (L1)", "DePIN", "Bittensor Ecosystem", "Polychain Capital Portfolio"], "preview_listing": false, "public_notice": null, "additional_notices": [], "description": {"en": "Bittensor is an open-source protocol that powers a decentralized, blockchain-based machine learning network. Machine learning models train collaboratively and are rewarded in TAO according to the informational value they offer the collective. TAO also grants external access, allowing users to extract information from the network while tuning its activities to their needs.\n\nUltimately, BitTensors vision is to create a pure market for artificial intelligence, an incentivized arena in which consumers and producers of this valuable commodity can interact in a trustless, open and transparent context.\n\nBittensor enables:\n\n-A novel, optimized strategy for the development and distribution of artificial intelligence technology by leveraging the possibilities of a distributed ledger. Specifically, its facilitation of open access/ownership, decentralized governance, and the ability to harness globally-distributed resources of computing power and innovation within an incentivized framework.\n\n-An open-source repository of machine intelligence, accessible to anyone, anywhere, thus creating the conditions for open and permission-less innovation on a global internet scale.\n\n-Distribution of rewards and network ownership to users in direct proportion to the value they have added."}, "links": {"homepage": ["https://bittensor.com/", "https://docs.bittensor.com/"], "whitepaper": "https://bittensor.com/whitepaper", "blockchain_site": ["https://taostats.io/", "https://bittensor.ai/explorer"], "official_forum_url": [], "chat_url": ["https://discord.gg/bittensor"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "opentensor", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "taobittensor", "subreddit_url": null, "repos_url": {"github": ["https://github.com/opentensor/BitTensor"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/28452/thumb/ARUsPeNQ_400x400.jpeg?1696527447", "small": "https://coin-images.coingecko.com/coins/images/28452/small/ARUsPeNQ_400x400.jpeg?1696527447", "large": "https://coin-images.coingecko.com/coins/images/28452/large/ARUsPeNQ_400x400.jpeg?1696527447"}, "country_origin": "", "genesis_date": null, "has_supply_breakdown": false, "sentiment_votes_up_percentage": 56.76, "sentiment_votes_down_percentage": 43.24, "watchlist_portfolio_users": 196724, "market_cap_rank": 42, "market_cap_rank_with_rehypothecated": 53, "market_data": {"current_price": {"vef": 19.04, "btc": 0.00298127, "bits": 2981.27, "sats": 298127, "usd": 190.12, "aed": 698.21, "ars": 285137, "aud": 272.2, "bdt": 23468, "bhd": 71.68, "bmd": 190.12, "brl": 974.99, "cad": 267.87, "chf": 155.39, "clp": 178092, "cny": 1286.38, "czk": 4029.88, "dkk": 1246.34, "eur": 166.74, "gbp": 142.85, "gel": 498.11, "hkd": 1490.71, "huf": 59927, "idr": 3438031, "ils": 581.69, "inr": 18165.16, "jpy": 31118, "krw": 276211, "kwd": 59.04, "lkr": 63881, "mmk": 399187, "mxn": 3312.84, "myr": 777.97, "ngn": 259584, "nok": 1842.64, "nzd": 328.01, "php": 11685.08, "pkr": 52805, "pln": 720.78, "rub": 14972.05, "sar": 713.38, "sek": 1839.74, "sgd": 245.5, "thb": 6364.42, "try": 9007.26, "twd": 6149.64, "uah": 8548.91, "vnd": 5006420, "zar": 3166.89, "xdr": 136.36, "xag": 3.31, "xau": 0.04703539, "eth": 0.09917076, "ltc": 4.097702, "bch": 0.89270631, "bnb": 0.33294903, "eos": 3039, "xrp": 178.924, "xlm": 1105, "link": 22.673942, "dot": 250.657, "yfi": 0.09444893, "sol": 2.563459}