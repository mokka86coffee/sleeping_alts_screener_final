 "sar": -1.00985, "sek": -1.38631, "sgd": -1.18362, "sol": -2.14053, "thb": -1.05689, "try": -1.10341, "twd": -1.11929, "uah": -1.45443, "usd": -1.1431, "vef": -1.1431, "vnd": -1.18295, "xag": -0.88892, "xau": -0.4944, "xdr": -1.2881, "xlm": -2.71898, "xrp": -3.20033, "yfi": -1.32167, "zar": -1.13238, "bits": -2.9456, "link": -1.76826, "sats": -2.9456}, "total_supply": 12785907.22660254, "max_supply": 18920000.0, "max_supply_infinite": false, "circulating_supply": 12783372.64171351, "outstanding_supply": null, "last_updated": "2026-07-29T14:14:15.681Z"}, "community_data": {"facebook_likes": null, "reddit_average_posts_48h": 0.0, "reddit_average_comments_48h": 0.0, "reddit_subscribers": 0, "reddit_accounts_active_48h": 0, "telegram_channel_user_count": 8586}, "developer_data": {"forks": 56, "stars": 93, "subscribers": 14, "total_issues": 0, "closed_issues": 0, "pull_requests_merged": 2929, "pull_request_contributors": 36, "code_additions_deletions_4_weeks": {"additions": 83752, "deletions": -38409}, "commit_count_4_weeks": 433, "last_4_weeks_commit_activity_series": []}, "status_updates": [{"description": "Release Announcement: Dash Platform v0.16 on Evonet. We're getting closer!\n\n-Deep DPP Refactoring to More Efficiently Represent Binary Data\n\n-Easier Definition of Binary Properties in Data Contract\n\n-Updated Structure and Consensus Rules for Identities\n\n-Fixed Source of Nondeterminism in Block Processing\n\nhttps://blog.dash.org/release-announcement-dash-platform-v0-16-on-evonet-a8772bdefdd9", "category": "general", "created_at": "2020-10-30T09:36:01.982Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}, {"description": "Starting now, LocalCryptos has enabled Dash trading on all P2P markets globally!\n\nTrades are InstantSend enabled, so most escrows will be 0-conf.\n\nStay tuned for joint activities during October, including fee waivers, and a crypto campus tour Venezuela!\n\nblog.localcryptos.com/dash-trading-begins/", "category": "general", "created_at": "2020-10-01T11:54:40.109Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}, {"description": "Dash Core v0.16 has been released!\n\nThis is a major and mandatory update that includes:\n-Block reward allocation\n-Improved UI/UX\n-PrivateSend enhancements\n-Bitcoin backports\n-And much more!\n\nDownload now: https://dash.org/downloads\n\nRead more: https://blog.dash.org/release-announcement-dash-core-v0-16-on-mainnet-870aa327240b", "category": "general", "created_at": "2020-09-30T20:32:12.349Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}, {"description": "Don't miss the second video of the Dash Platform series! In this one, Amanda B. Johnson explains Dash Drive:\n\nhttps://youtu.be/14N5pnl5W0Y\n\nIf you didn't watch the first introduction episode that explained how Dash is becoming a cloud, watch it here:\n\nhttps://youtu.be/9WqUMrIN58Q", "category": "general", "created_at": "2020-09-25T12:17:20.048Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}, {"description": "Update on recent business development activities at Dash Core Group:\n\n-Growth in Venezuela\n-Dash FastPass Alliance\n-Improve Dash Accessibility Worldwide\n\nWatch the two-minute video on Twitter:\ntwitter.com/i/status/1308461561615462401", "category": "general", "created_at": "2020-09-22T19:06:46.483Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}, {"description": "Watch the latest Dash product update by Dana Alibrandi, Head of Product at Dash Core Group.\n\n-Dash Core v0.16 RC3\n-Frequent contacts on Dashpay iOS\n-Dashpay Alpha Testing Program\n-New home screen design on Dash mobile wallets\n-Dash Platform v0.15 released to Evonet\n-Several DIPs to be published shortly\n\nhttps://youtu.be/7_mhXRj_w0I", "category": "general", "created_at": "2020-09-15T17:35:30.225Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}, {"description": "Check out the updated product brief for Dash Core v0.16, which has a target release date for the end of September. Release Candidate 3 will hit testnet next week.\n\nBesides what we previously announced, this release will include the block reward reallocation and UI/UX improvements.\n\nhttps://blog.dash.org/updated-product-brief-dash-core-release-v0-16-0-d3debdb6242e", "category": "general", "created_at": "2020-09-10T22:51:13.662Z", "user": "Fernando Gutierrez", "user_title": "CMO, Dash Core Group", "pin": false, "project": {"type": "Coin", "id": "dash", "name": "Dash", "symbol": "dash", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/19/thumb/dash-logo.png?1696501423", "small": "https://coin-images.coingecko.com/coins/images/19/small/dash-logo.png?1696501423", "large": "https://coin-images.coingecko.com/coins/images/19/large/dash-logo.png?1696501423"}}}], "last_updated": "2026-07-29T14:14:15.681Z"}