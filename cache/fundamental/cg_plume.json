ume.org/"], "whitepaper": "https://docs.plume.org/", "blockchain_site": ["https://etherscan.io/token/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://intel.arkm.com/explorer/token/plume", "https://ethplorer.io/address/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://bscscan.com/token/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8", "https://binplorer.com/address/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/plume-network"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "plumenetwork", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "plumenetwork_community", "subreddit_url": null, "repos_url": {"github": ["https://github.com/plumenetwork"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/53623/thumb/plume-token.png?1736896935", "small": "https://coin-images.coingecko.com/coins/images/53623/small/plume-token.png?1736896935", "large": "https://coin-images.coingecko.com/coins/images/53623/large/plume-token.png?1736896935"}, "country_origin": "", "genesis_date": null, "contract_address": "0x4c1746a800d224393fe2470c70a35717ed4ea5f1", "has_supply_breakdown": false, "sentiment_votes_up_percentage": 71.43, "sentiment_votes_down_percentage": 28.57, "watchlist_portfolio_users": 24173, "market_cap_rank": 310, "market_cap_rank_with_rehypothecated": 426, "market_data": {"current_price": {"vef": 0.00119902, "btc": 1.86336e-07, "bits": 0.186336, "sats": 18.63, "eth": 6.31e-06, "ltc": 0.00026539, "bch": 5.695e-05, "bnb": 2.107e-05, "eos": 0.19982362, "xrp": 0.01116494, "xlm": 0.0693206, "link": 0.00144243, "dot": 0.01576282, "yfi": 6.04e-06, "sol": 0.00016308, "usd": 0.01197463, "aed": 0.04397684, "ars": 17.93, "aud": 0.01723967, "bdt": 1.48, "bhd": 0.00451526, "bmd": 0.01197463, "brl": 0.061472, "cad": 0.01686249, "chf": 0.00980423, "clp": 11.22, "cny": 0.081083, "czk": 0.254257, "dkk": 0.078582, "eur": 