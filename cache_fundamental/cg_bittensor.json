{"id": "bittensor", "symbol": "tao", "name": "Bittensor", "web_slug": "bittensor", "asset_platform_id": null, "platforms": {"": ""}, "detail_platforms": {"": {"decimal_place": null, "contract_address": ""}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Artificial Intelligence (AI)", "Smart Contract Platform", "Layer 1 (L1)", "DePIN", "Bittensor Ecosystem", "Polychain Capital Portfolio"], "preview_listing": false, "public_notice": null, "additional_notices": [], "description": {"en": "Bittensor is an open-source protocol that powers a decentralized, blockchain-based machine learning network. Machine learning models train collaboratively and are rewarded in TAO according to the informational value they offer the collective. TAO also grants external access, allowing users to extract information from the network while tuning its activities to their needs.\n\nUltimately, BitTensors vision is to create a pure market for artificial intelligence, an incentivized arena in which consumers and producers of this valuable commodity can interact in a trustless, open and transparent context.\n\nBittensor enables:\n\n-A novel, optimized strategy for the development and distribution of artificial intelligence technology by leveraging the possibilities of a distributed ledger. Specifically, its facilitation of open access/ownership, decentralized governance, and the ability to harness globally-distributed resources of computing power and innovation within an incentivized framework.\n\n-An open-source repository of machine intelligence, accessible to anyone, anywhere, thus creating the conditions for open and permission-less innovation on a global internet scale.\n\n-Distribution of rewards and network ownership to users in direct proportion to the value they have added."}, "links": {"homepage": ["https://bittensor.com/", "https://docs.bittensor.com/"], "whitepaper": "https://bittensor.com/whitepaper", "blockchain_site": ["https://taostats.io/", "https://bittensor.ai/explorer"], "official_forum_url": [], "chat_url": ["https://discord.gg/bittensor"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "opentensor", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "taobittensor", "subreddit_url": null, "repos_url": {"github": ["https://github.com/opentensor/BitTensor"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/28452/thumb/ARUsPeNQ_400x400.jpeg?1696527447", "small": "https://coin-images.coingecko.com/coins/images/28452/small/ARUsPeNQ_400x400.jpeg?1696527447", "large": "https://coin-images.coingecko.com/coins/images/28452/large/ARUsPeNQ_400x400.jpeg?1696527447"}, "country_origin": "", "genesis_date": null, "has_supply_breakdown": false, "sentiment_votes_up_percentage": 54.05, "sentiment_votes_down_percentage": 45.95, "watchlist_portfolio_users": 196754, "market_cap_rank": 42, "market_cap_rank_with_rehypothecated": 53, "market_data": {"current_price": {"vef": 19.32, "btc": 0.00302762, "bits": 3027.62, "sats": 302762, "usd": 192.94, "aed": 708.56, "ars": 289360, "aud": 276.65, "bdt": 23816, "bhd": 72.75, "bmd": 192.94, "brl": 991.43, "cad": 272.17, "chf": 158.12, "clp": 180373, "cny": 1306.36, "czk": 4096.45, "dkk": 1266.82, "eur": 169.47, "gbp": 145.24, "gel": 505.49, "hkd": 1512.85, "huf": 61115, "idr": 3488387, "ils": 590.31, "inr": 18444.48, "jpy": 31615, "krw": 280430, "kwd": 59.93, "lkr": 64828, "mmk": 405104, "mxn": 3365.61, "myr": 789.32, "ngn": 263745, "nok": 1868.3, "nzd": 333.71, "php": 11858.48, "pkr": 53596, "pln": 733.25, "rub": 15193.57, "sar": 725.23, "sek": 1870.77, "sgd": 249.37, "thb": 6477.98, "try": 9143.16, "twd": 6246.7, "uah": 8675.63, "vnd": 5080629, "zar": 3223.72, "xdr": 138.38, "xag": 3.39, "xau": 0.04801234, "eth": 0.10088799, "ltc": 4.184997, "bch": 0.90283715, "bnb": 0.33903234, "eos": 3106, "xrp": 181.286, "xlm": 1114, "link": 22.969239, "dot": 253.917, "yfi": 0.09614651, "sol": 2.628303}