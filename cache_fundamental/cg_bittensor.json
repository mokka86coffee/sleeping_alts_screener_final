{"id": "bittensor", "symbol": "tao", "name": "Bittensor", "web_slug": "bittensor", "asset_platform_id": null, "platforms": {"": ""}, "detail_platforms": {"": {"decimal_place": null, "contract_address": ""}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Artificial Intelligence (AI)", "Smart Contract Platform", "Layer 1 (L1)", "DePIN", "Bittensor Ecosystem", "Polychain Capital Portfolio"], "preview_listing": false, "public_notice": null, "additional_notices": [], "description": {"en": "Bittensor is an open-source protocol that powers a decentralized, blockchain-based machine learning network. Machine learning models train collaboratively and are rewarded in TAO according to the informational value they offer the collective. TAO also grants external access, allowing users to extract information from the network while tuning its activities to their needs.\n\nUltimately, BitTensors vision is to create a pure market for artificial intelligence, an incentivized arena in which consumers and producers of this valuable commodity can interact in a trustless, open and transparent context.\n\nBittensor enables:\n\n-A novel, optimized strategy for the development and distribution of artificial intelligence technology by leveraging the possibilities of a distributed ledger. Specifically, its facilitation of open access/ownership, decentralized governance, and the ability to harness globally-distributed resources of computing power and innovation within an incentivized framework.\n\n-An open-source repository of machine intelligence, accessible to anyone, anywhere, thus creating the conditions for open and permission-less innovation on a global internet scale.\n\n-Distribution of rewards and network ownership to users in direct proportion to the value they have added."}, "links": {"homepage": ["https://bittensor.com/", "https://docs.bittensor.com/"], "whitepaper": "https://bittensor.com/whitepaper", "blockchain_site": ["https://taostats.io/", "https://bittensor.ai/explorer"], "official_forum_url": [], "chat_url": ["https://discord.gg/bittensor"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "opentensor", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "taobittensor", "subreddit_url": null, "repos_url": {"github": ["https://github.com/opentensor/BitTensor"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/28452/thumb/ARUsPeNQ_400x400.jpeg?1696527447", "small": "https://coin-images.coingecko.com/coins/images/28452/small/ARUsPeNQ_400x400.jpeg?1696527447", "large": "https://coin-images.coingecko.com/coins/images/28452/large/ARUsPeNQ_400x400.jpeg?1696527447"}, "country_origin": "", "genesis_date": null, "has_supply_breakdown": false, "sentiment_votes_up_percentage": 58.62, "sentiment_votes_down_percentage": 41.38, "watchlist_portfolio_users": 196660, "market_cap_rank": 42, "market_cap_rank_with_rehypothecated": 53, "market_data": {"current_price": {"vef": 19.88, "btc": 0.00303971, "bits": 3039.71, "sats": 303971, "usd": 198.5, "aed": 728.98, "ars": 297544, "aud": 283.72, "bdt": 24507, "bhd": 74.81, "bmd": 198.5, "brl": 1015.03, "cad": 279.9, "chf": 162.45, "clp": 187432, "cny": 1344.1, "czk": 4216.5, "dkk": 1304.53, "eur": 174.51, "gbp": 149.13, "gel": 521.05, "hkd": 1556.64, "huf": 62917, "idr": 3585865, "ils": 606.36, "inr": 19050.21, "jpy": 32504, "krw": 291859, "kwd": 61.6, "lkr": 66755, "mmk": 416778, "mxn": 3469.0, "myr": 810.96, "ngn": 270622, "nok": 1916.98, "nzd": 342.92, "php": 12251.61, "pkr": 55144, "pln": 754.51, "rub": 15486.75, "sar": 743.9, "sek": 1929.78, "sgd": 256.31, "thb": 6677.63, "try": 9399.1, "twd": 6412.83, "uah": 8915.77, "vnd": 5223597, "zar": 3326.59, "xdr": 142.01, "xag": 3.39, "xau": 0.04871506, "eth": 0.10124806, "ltc": 4.212548, "bch": 0.90997253, "bnb": 0.34579946, "eos": 3056, "xrp": 179.317, "xlm": 1099, "link": 22.650537, "dot": 246.249, "yfi": 0.09417333, "sol": 2.58308}, "tota