{"id": "ecash", "symbol": "xec", "name": "eCash", "web_slug": "ecash", "asset_platform_id": null, "platforms": {"": ""}, "detail_platforms": {"": {"decimal_place": null, "contract_address": ""}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Smart Contract Platform", "Layer 1 (L1)", "Bitcoin Fork", "Proof of Work (PoW)"], "preview_listing": false, "public_notice": null, "additional_notices": [], "description": {"en": "eCash (XEC) is a Layer-1 digital cash network, developed by Bitcoin ABC. It was created on Nov 15th, 2020, and has since distinguished itself from its predecessors and other Bitcoin clients by integrating the breakthrough Avalanche consensus with its core proof-of-work (PoW) layer, extending its security and fundamental capabilities.\n\nThis Nakamoto/Avalanche hybrid consensus integration gives it unique properties for a Bitcoin-like chain, such as instant transaction finality, staking rewards, extensibility through subnets, and flexible protocol governance.\n\nThe development roadmap is set with three main goals:\nScaling transaction throughput from ~100 tps to more than 5.000.000 tps\nImproving the payment experience with a less than 3 second transaction finality time\nExtending the protocol and establishing fork-free upgrades, allowing for more rapid, iterative development"}, "links": {"homepage": ["https://e.cash/", "https://ecash.community/", "https://x.com/eCash"], "whitepaper": "https://e.cash/bitcoin.pdf", "blockchain_site": ["https://ecash.coin.dance/", "https://explorer.e.cash/"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/HaVRXcST7n", "https://www.youtube.com/@eCashOfficial"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "ecash", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": null, "subreddit_url": "https://www.reddit.com/r/ecash/", "repos_url": {"github": ["https://github.com/bitcoin-abc"], "bitbucket": []}}, "image": {"t