{"id": "irys", "symbol": "irys", "name": "Irys", "web_slug": "irys", "asset_platform_id": null, "platforms": {"": "", "ethereum": "0x50f41f589afaca2ef41fdf590fe7b90cd26dee64", "binance-smart-chain": "0x91152b4ef635403efbae860edd0f8c321d7c035d"}, "detail_platforms": {"": {"decimal_place": null, "contract_address": ""}, "ethereum": {"decimal_place": 18, "contract_address": "0x50f41f589afaca2ef41fdf590fe7b90cd26dee64", "geckoterminal_url": "https://www.geckoterminal.com/eth/tokens/0x50f41f589afaca2ef41fdf590fe7b90cd26dee64"}, "binance-smart-chain": {"decimal_place": 18, "contract_address": "0x91152b4ef635403efbae860edd0f8c321d7c035d", "geckoterminal_url": "https://www.geckoterminal.com/bsc/tokens/0x91152b4ef635403efbae860edd0f8c321d7c035d"}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["BNB Chain Ecosystem", "Layer 1 (L1)", "Ethereum Ecosystem", "Binance Wallet IDO"], "preview_listing": false, "public_notice": null, "additional_notices": [], "description": {"en": "Irys is a Layer 1 datachain that unifies onchain data storage and smart contract execution into a single network. Traditional smart contract chains handle financial transactions but lack native primitives for working with data at scale. Traditional datachains handle storage but lack integration with smart contracts. Irys serves both. Irys bridges this gap by unifying storage and execution, making data programmable through IrysVM, its native EVM execution layer. The network offers flexible storage options: users can choose between term storage (temporary, duration-based) or permanent storage (one-time payment for perpetual retention). Both operate at at-cost pricing, made possible by Irys's multi-revenue model that combines storage fees, execution fees, and programmable data transactions. This design allows Irys to remain competitive on price while maintaining economic sustainability. Irys achieves instant data retrieval and infinite horizontal scaling. As demand grows, the network expands capacity by adding validators who prove continuous maintenance of their assigned data partitions. The network's native token, $IRYS, is used for all storage and execution fees, as well as validator staking."}, "links": {"homepage": ["https://irys.xyz/"], "whitepaper": "https://irys.xyz/assets/IrysWhitepaper.pdf", "blockchain_site": ["https://explorer.irys.xyz/", "https://etherscan.io/token/0x50f41F589aFACa2EF41FDF590FE7b90cD26DEe64", "https://ethplorer.io/address/0x50f41F589aFACa2EF41FDF590FE7b90cD26DEe64", "https://bscscan.com/token/0x91152B4Ef635403efBAe860edD0F8c321d7c035d", "https://binplorer.com/address/0x91152B4Ef635403efBAe860edD0F8c321d7c035d"], "official_forum_url": ["https://linkedin.com/company/irys-xyz"], "chat_url": ["https://discord.com/invite/irys", "https://irys.xyz/blog", "https://www.youtube.com/@irys_xyz"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "irys_xyz", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "", "subreddit_url": null, "repos_url": {"github": ["https://github.com/Irys-xyz/irys"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/70808/thumb/irys.png?1764757341", "small": "https://coin-images.coingecko.com/coins/images/70808/small/irys.png?1764757341", "large": "https://coin-images.coingecko.com/coins/images/70808/large/irys.png?1764757341"}, "country_origin": "", "genesis_date": null, "has_supply_breakdown": false, "sentiment_votes_up_percentage": 40.0, "sentiment_votes_down_percentage": 60.0, "watchlist_portfolio_users": 2008, "market_cap_rank": 648, "market_cap_rank_with_rehypothecated": 825, "market_data": {"current_price": {"vef": 0.00144239, "btc": 2.22427e-07, "bits": 0.222427, "sats": 22.24, "eth": 7.41e-06, "ltc": 0.0003095, "bch": 6.703e-05, "bnb": 2.514e-05, "eos": 0.22390733, "xrp": 0.01324483, "xlm": 0.08189603, "link": 0.00167771, "dot": 0.01821381, "yfi": 6.83e-06, "sol": 0.00019063, "usd": 0.01440512, "a