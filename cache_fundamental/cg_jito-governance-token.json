{"id": "jito-governance-token", "symbol": "jto", "name": "Jito", "web_slug": "jito", "asset_platform_id": "solana", "platforms": {"solana": "jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL"}, "detail_platforms": {"solana": {"decimal_place": 9, "contract_address": "jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL", "geckoterminal_url": "https://www.geckoterminal.com/solana/tokens/jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL"}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Decentralized Finance (DeFi)", "Solana Ecosystem", "Liquid Staking Governance Tokens", "Multicoin Capital Portfolio", "Alameda Research Portfolio", "Delphi Ventures Portfolio", "Liquid Staking", "Made in USA"], "preview_listing": false, "public_notice": null, "additional_notices": [], "has_supply_breakdown": false, "description": {"en": "JTO is the governance token of the Jito Network. Jito Network is a major contributor to the Solana ecosystem through its JitoSOL liquid staking pool, and its collection of MEV products. Users can exchange their SOL for JitoSOL. In return, holders maintain SOL’s liquidity and DeFi opportunities while earning yield from staking. JitoSOL uniquely provides its holders with additional rewards from transaction revenue associated with MEV extraction on Solana. Maximum extractable value (MEV) describes profit opportunities attributable to the specific order of transaction execution. For example, a large swap on Orca can lower the pool’s price below that of Raydium or Serum. Traders will race to profit from that price difference and this arbitrage is considered MEV. The Jito Foundation was created to minimize the negative impacts of MEV, equitably distribute the profits and increase transparency. Jito published an open source validator client designed to create a competitive market for MEV extraction. The client enables auctions within each block for the opportunity to capture that block’s MEV. Traders submit bids, and the highest bidders within each block can harvest available MEV."}, "links": {"homepage": ["https://www.jito.network/", "https://www.jito.network/blog/announcing-jto-the-jito-governance-token/", "http://jtx.trade/"], "whitepaper": "", "blockchain_site": ["https://solscan.io/token/jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL", "https://intel.arkm.com/explorer/token/jito-governance-token"], "official_forum_url": ["https://x.com/jtx_trade", "http://jito.network/manifesto"], "chat_url": ["https://discord.gg/jtxcommunity", "https://www.youtube.com/@jitosolana"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "jito_sol", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "jtx_trade", "subreddit_url": null, "repos_url": {"github": [], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/33228/thumb/jto.png?1701137022", "small": "https://coin-images.coingecko.com/coins/images/33228/small/jto.png?1701137022", "large": "https://coin-images.coingecko.com/coins/images/33228/large/jto.png?1701137022"}, "country_origin": "", "genesis_date": null, "contract_address": "jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL", "sentiment_votes_up_percentage": 33.33, "sentiment_votes_down_percentage": 66.67, "watchlist_portfolio_users": 37287, "market_cap_rank": 127, "market_cap_rank_with_rehypothecated": 177, "market_data": {"current_price": {"aed": 2.28, "ars": 928.7, "aud": 0.88648, "bch": 0.00286902, "bdt": 76.57, "bhd": 0.233634, "bmd": 0.620571, "bnb": 0.0010809, "brl": 3.16, "btc": 9.52e-06, "cad": 0.874855, "chf": 0.505969, "clp": 588.69, "cny": 4.2, "czk": 13.15, "dkk": 4.07, "dot": 0.76231934, "eos": 9.779278, "eth": 0.00031604, "eur": 0.544538, "gbp": 0.465391, "gel": 1.63, "hkd": 4.87, "huf": 196.07, "idr": 11174.31, "ils": 1.88, "inr": 59.52, "jpy": 101.48, "krw": 911.98, "kwd": 0.192497, "lkr": 208.61, "ltc": 0.013133, "mmk": 1302.99, "mxn": 10.82, "myr": 2.54, "ngn": 846.89, "nok": 5.97, "nzd": 1.07, "php": 38.3, "pkr": 172