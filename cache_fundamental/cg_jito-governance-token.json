{"id": "jito-governance-token", "symbol": "jto", "name": "Jito", "web_slug": "jito", "asset_platform_id": "solana", "platforms": {"solana": "jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL"}, "detail_platforms": {"solana": {"decimal_place": 9, "contract_address": "jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL", "geckoterminal_url": "https://www.geckoterminal.com/solana/tokens/jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL"}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Decentralized Finance (DeFi)", "Solana Ecosystem", "Liquid Staking Governance Tokens", "Multicoin Capital Portfolio", "Alameda Research Portfolio", "Delphi Ventures Portfolio", "Liquid Staking", "Made in USA"], "preview_listing": false, "public_notice": null, "additional_notices": [], "has_supply_breakdown": false, "description": {"en": "JTO is the governance token of the Jito Network. Jito Network is a major contributor to the Solana ecosystem through its JitoSOL liquid staking pool, and its collection of MEV products. Users can exchange their SOL for JitoSOL. In return, holders maintain SOL’s liquidity and DeFi opportunities while earning yield from staking. JitoSOL uniquely provides its holders with additional rewards from transaction revenue associated with MEV extraction on Solana. Maximum extractable value (MEV) describes profit opportunities attributable to the specific order of transaction execution. For example, a large swap on Orca can lower the pool’s price below that of Raydium or Serum. Traders will race to profit from that price difference and this arbitrage is considered MEV. The Jito Foundation was created to minimize the negative impacts of MEV, equitably distribute the profits and increase transparency. Jito published an open source validator client designed to create a competitive market for MEV extraction. The client enables auctions within each block for the opportunity to capture that block’s MEV. Traders submit bids, and the highest bidders within each block can harvest available MEV."}, "links": {"homepage": ["https://www.jito.network/", "https://www.jito.network/blog/announcing-jto-the-jito-governance-token/", "http://jtx.trade/"], "whitepaper": "", "blockchain_site": ["https://solscan.io/token/jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL", "https://intel.arkm.com/explorer/token/jito-governance-token"], "official_forum_url": ["https://x.com/jtx_trade", "http://jito.network/manifesto"], "chat_url": ["https://discord.gg/jtxcommunity", "https://www.youtube.com/@jitosolana"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "jito_sol", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "jtx_trade", "subreddit_url": null, "repos_url": {"github": [], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/33228/thumb/jto.png?1701137022", "small": "https://coin-images.coingecko.com/coins/images/33228/small/jto.png?1701137022", "large": "https://coin-images.coingecko.com/coins/images/33228/large/jto.png?1701137022"}, "country_origin": "", "genesis_date": null, "contract_address": "jtojtomepa8beP8AuQc6eXt5FriJwfFMwQx2v2f9mCL", "sentiment_votes_up_percentage": 50.0, "sentiment_votes_down_percentage": 50.0, "watchlist_portfolio_users": 37288, "market_cap_rank": 130, "market_cap_rank_with_rehypothecated": 183, "market_data": {"current_price": {"aed": 2.13, "ars": 866.08, "aud": 0.827754, "bch": 0.0026917, "bdt": 71.44, "bhd": 0.218111, "bmd": 0.578606, "bnb": 0.00100955, "brl": 2.97, "btc": 8.93e-06, "cad": 0.817182, "chf": 0.473763, "clp": 544.1, "cny": 3.91, "czk": 12.29, "dkk": 3.8, "dot": 0.73121202, "eos": 8.956814, "eth": 0.00029776, "eur": 0.508723, "gbp": 0.435143, "gel": 1.52, "hkd": 4.54, "huf": 183.09, "idr": 10450.78, "ils": 1.77, "inr": 55.41, "jpy": 94.73, "krw": 847.79, "kwd": 0.17962, "lkr": 194.59, "ltc": 0.01242683, "mmk": 1214.88, "mxn": 10.09, "myr": 2.37, "ngn": 789.7, "nok": 5.59, "nzd": 1.002, "php": 35.7, "pkr": 160.