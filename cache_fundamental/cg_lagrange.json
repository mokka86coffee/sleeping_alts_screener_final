{"id": "lagrange", "symbol": "la", "name": "Lagrange", "web_slug": "lagrange", "asset_platform_id": "ethereum", "platforms": {"ethereum": "0x0fc2a55d5bd13033f1ee0cdd11f60f7efe66f467", "binance-smart-chain": "0x389ad4bb96d0d6ee5b6ef0efaf4b7db0ba2e02a0"}, "detail_platforms": {"ethereum": {"decimal_place": 18, "contract_address": "0x0fc2a55d5bd13033f1ee0cdd11f60f7efe66f467", "geckoterminal_url": "https://www.geckoterminal.com/eth/tokens/0x0fc2a55d5bd13033f1ee0cdd11f60f7efe66f467"}, "binance-smart-chain": {"decimal_place": 18, "contract_address": "0x389ad4bb96d0d6ee5b6ef0efaf4b7db0ba2e02a0", "geckoterminal_url": "https://www.geckoterminal.com/bsc/tokens/0x389ad4bb96d0d6ee5b6ef0efaf4b7db0ba2e02a0"}}, "block_time_in_minutes": 0, "hashing_algorithm": null, "categories": ["Artificial Intelligence (AI)", "BNB Chain Ecosystem", "Ethereum Ecosystem", "Zero Knowledge (ZK)", "Binance HODLer Airdrops", "Binance Alpha Spotlight"], "preview_listing": false, "public_notice": null, "additional_notices": [], "description": {"en": "Today, Lagrange has expanded its ZK Prover Network to power proof generation for ZK rollups, adding onto Lagrange’s existing ZK Coprocessor and State Committee offerings. With this new addition, Lagrange now unlocks proofs for anything – for rollups, apps, coprocessors and interoperability – as an infinite proving layer that enables anyone to prove everything at internet scale. Previously, Lagrange launched the first production-ready ZK prover network in the industry, operated by top operators including Coinbase, Kraken, OKX and more. Now, Lagrange’s ZK Prover Network is expanding to address key challenges faced by rollups and advance ZK adoption and utility.\n\nThe ZK Coprocessor can generate a proof of correct computation over arbitrary storage slots for arbitrary block ranges. For example, consider an application that wishes to compute the average on Ethereum for ETH / USDC pricing. A developer must first specify the memory slots and block range (~50,400) that they are interested in including in the data set. Next the developer writes the computations that is to be executed across the storage slots over the different blocks in parallel. Once the proof is generated, it will prove both the storage inclusion and the aggregated computation as valid with respect to a block header derived from smart contract information."}, "links": {"homepage": ["https://www.lagrangefoundation.org"], "whitepaper": "https://www.lagrange.dev/blog", "blockchain_site": ["https://etherscan.io/token/0x0fc2a55d5BD13033f1ee0cdd11f60F7eFe66f467", "https://intel.arkm.com/explorer/token/lagrange", "https://ethplorer.io/address/0x0fc2a55d5BD13033f1ee0cdd11f60F7eFe66f467", "https://bscscan.com/token/0x389AD4bb96d0D6EE5B6eF0EFAF4b7db0bA2e02a0", "https://binplorer.com/address/0x389AD4bb96d0D6EE5B6eF0EFAF4b7db0bA2e02a0"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/Hnr52BvWUk"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "lagrangefndn", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "", "subreddit_url": null, "repos_url": {"github": ["https://github.com/Lagrange-Labs"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/55550/thumb/Lagrange-logo-png-gradient.png?1746637731", "small": "https://coin-images.coingecko.com/coins/images/55550/small/Lagrange-logo-png-gradient.png?1746637731", "large": "https://coin-images.coingecko.com/coins/images/55550/large/Lagrange-logo-png-gradient.png?1746637731"}, "country_origin": "", "genesis_date": null, "contract_address": "0x0fc2a55d5bd13033f1ee0cdd11f60f7efe66f467", "has_supply_breakdown": false, "sentiment_votes_up_percentage": 100.0, "sentiment_votes_down_percentage": 0.0, "watchlist_portfolio_users": 2486, "market_cap_rank": 983, "market_cap_rank_with_rehypothecated": 1226, "market_data": {"current_price": {"vef": 0.00728762, "btc": 1.12e-06, "bits": 1.12, "sats": 111.6, "eth": 3.7