slots and block range (~50,400) that they are interested in including in the data set. Next the developer writes the computations that is to be executed across the storage slots over the different blocks in parallel. Once the proof is generated, it will prove both the storage inclusion and the aggregated computation as valid with respect to a block header derived from smart contract information."}, "links": {"homepage": ["https://www.lagrangefoundation.org"], "whitepaper": "https://www.lagrange.dev/blog", "blockchain_site": ["https://etherscan.io/token/0x0fc2a55d5BD13033f1ee0cdd11f60F7eFe66f467", "https://intel.arkm.com/explorer/token/lagrange", "https://ethplorer.io/address/0x0fc2a55d5BD13033f1ee0cdd11f60F7eFe66f467", "https://bscscan.com/token/0x389AD4bb96d0D6EE5B6eF0EFAF4b7db0bA2e02a0", "https://binplorer.com/address/0x389AD4bb96d0D6EE5B6eF0EFAF4b7db0bA2e02a0"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/Hnr52BvWUk"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "lagrangefndn", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "", "subreddit_url": null, "repos_url": {"github": ["https://github.com/Lagrange-Labs"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/55550/thumb/Lagrange-logo-png-gradient.png?1746637731", "small": "https://coin-images.coingecko.com/coins/images/55550/small/Lagrange-logo-png-gradient.png?1746637731", "large": "https://coin-images.coingecko.com/coins/images/55550/large/Lagrange-logo-png-gradient.png?1746637731"}, "country_origin": "", "genesis_date": null, "contract_address": "0x0fc2a55d5bd13033f1ee0cdd11f60f7efe66f467", "sentiment_votes_up_percentage": 100.0, "sentiment_votes_down_percentage": 0.0, "watchlist_portfolio_users": 2492, "market_cap_rank": 1009, "market_cap_rank_with_rehypothecated": 1257, "market_data": {"current_price": {"aed": 0.249838, "ars": 101.83, "aud": 0.0973, "bch": 0.00031631, "bdt": 8