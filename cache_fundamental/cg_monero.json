er_count": null}, "developer_data": {"forks": 3594, "stars": 8309, "subscribers": 496, "total_issues": 2954, "closed_issues": 2555, "pull_requests_merged": 4875, "pull_request_contributors": 320, "code_additions_deletions_4_weeks": {"additions": 0, "deletions": 0}, "commit_count_4_weeks": 0, "last_4_weeks_commit_activity_series": []}, "status_updates": [{"description": "We're excited to announce that XMR has been added to dYdX synthetic perpetuals! \n\nAccording to CoinMarketCap, dYdX has more trading volume than all other DEXs combined! \n\nhttps://dydx.exchange/blog/markets-19 ", "category": "exchange_listing", "created_at": "2021-09-29T15:50:02.560Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}, {"description": "This is a huge milestone in Monero development.\n\nCOMIT Network just released Bitcoin &lt;&gt; Monero atomic swaps to mainnet. Today, users can swap Bitcoin and Monero without having to trust an intermediary or the counterparty.\n\nCOMIT's atomic swaps are a critical tool for private trading of Monero outside of exchanges.\n\nOh, and as a bonus it works with Tor. Because of course it does.\n\nhttps://www.reddit.com/r/Monero/comments/nmtdpr/let_there_be_swap_on_mainnet/", "category": "milestone", "created_at": "2021-05-28T13:44:59.020Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}, {"description": "Monero's price isn't the only metric on the rise. Checkout the other key ways Monero has been growing over the past year! \n\nhttps://www.getmonero.org/2021/04/24/this-year-in-monero.html", "category": "general", "created_at": "2021-05-07T14:00:41.103Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}, {"description": "Monero Talk sits down with COMIT to discuss their work on Monero &lt;&gt; Bitcoin atomic swaps. This technology allows for trustless trading of both assets without requiring an exchange. \n\n\"COMIT: Bitcoin-Monero Atomic Swaps are Near\" \nhttps://www.youtube.com/watch?v=cuZrtHNTixo \n\nCOMIT is one of about 5 different groups working on implementing XMR &lt;&gt; BTC atomic swaps.", "category": "general", "created_at": "2021-02-19T20:19:31.810Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}, {"description": "Dr. Daniel Kim's new keynote lecture \"Behavioral Finance, Cryptocurrency Markets\" premieres in about 45 minutes! \n\nhttps://youtu.be/REC5V7d3pqM \n\nIn this TCV Summit keynote lecture from February 2021, Dr. Daniel Kim weaves together award-winning research from academic finance with case studies from both the legacy financial and cryptocurrency markets to examine the degree to which cryptocurrency markets achieve efficient price discovery.", "category": "general", "created_at": "2021-02-14T19:15:30.496Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}, {"description": "The Monero community is calling on Elon Musk to add Monero payments for Tesla!\n\nMonero is the cypherpunk currency defending your freedom. We will not stop on our mission to give people the money that they deserve.\n\nIf Monero is added, we will donate a new Model 3 to EACH of 3 charities selected by the community! #Tesla4XMR\n\nWe need the ENTIRE Monero community to help us share the word! Help us support a worthy project and worthy nonprofits!\n\nhttps://monerotesla.com", "category": "general", "created_at": "2021-02-10T03:54:53.199Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}, {"description": "Cake Wallet, a popular non-custodial wallet for Monero, now additionally supports Bitcoin! \n\nOnly you hold your Monero and Bitcoin keys. Still open source. Easily exchange BTC/XMR (and others) in the app. Available for free in the iOS and Google Play stores. \n\nhttps://www.reddit.com/r/cakewallet/comments/lb2mpj/update_cake_wallet_version_410_now_with_bitcoin/", "category": "software_release", "created_at": "2021-02-02T19:04:50.386Z", "user": "Justin Ehrenhofer", "user_title": "Monero Space Organizer", "pin": false, "project": {"type": "Coin", "name": "Monero", "image": {"thumb": "https://coin-images.coingecko.com/coins/images/69/thumb/monero_logo.png?1696501460", "small": "https://coin-images.coingecko.com/coins/images/69/small/monero_logo.png?1696501460", "large": "https://coin-images.coingecko.com/coins/images/69/large/monero_logo.png?1696501460"}, "id": "monero", "symbol": "xmr"}}], "last_updated": "2026-07-28T23:42:58.439Z"}