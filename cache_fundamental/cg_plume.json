ume.org/"], "whitepaper": "https://docs.plume.org/", "blockchain_site": ["https://etherscan.io/token/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://intel.arkm.com/explorer/token/plume", "https://ethplorer.io/address/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://bscscan.com/token/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8", "https://binplorer.com/address/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/plume-network"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "plumenetwork", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "plumenetwork_community", "subreddit_url": null, "repos_url": {"github": ["https://github.com/plumenetwork"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/53623/thumb/plume-token.png?1736896935", "small": "https://coin-images.coingecko.com/coins/images/53623/small/plume-token.png?1736896935", "large": "https://coin-images.coingecko.com/coins/images/53623/large/plume-token.png?1736896935"}, "country_origin": "", "genesis_date": null, "contract_address": "0x4c1746a800d224393fe2470c70a35717ed4ea5f1", "has_supply_breakdown": false, "sentiment_votes_up_percentage": 85.71, "sentiment_votes_down_percentage": 14.29, "watchlist_portfolio_users": 24160, "market_cap_rank": 304, "market_cap_rank_with_rehypothecated": 420, "market_data": {"current_price": {"vef": 0.00123356, "btc": 1.88686e-07, "bits": 0.188686, "sats": 18.87, "usd": 0.01231956, "aed": 0.04524358, "ars": 18.47, "aud": 0.01760906, "bdt": 1.52, "bhd": 0.00464284, "bmd": 0.01231956, "brl": 0.062997, "cad": 0.01737173, "chf": 0.01008235, "clp": 11.63, "cny": 0.083421, "czk": 0.261694, "dkk": 0.080965, "eur": 0.01083105, "gbp": 0.00925548, "gel": 0.03233885, "hkd": 0.096612, "huf": 3.9, "idr": 222.55, "ils": 0.03763305, "inr": 1.18, "jpy": 2.02, "krw": 18.11, "kwd": 0.00382323, "lkr": 4.14, "mmk": 25.87, "mxn