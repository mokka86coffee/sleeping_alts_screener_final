ume.org/"], "whitepaper": "https://docs.plume.org/", "blockchain_site": ["https://etherscan.io/token/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://intel.arkm.com/explorer/token/plume", "https://ethplorer.io/address/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://bscscan.com/token/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8", "https://binplorer.com/address/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/plume-network"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "plumenetwork", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "plumenetwork_community", "subreddit_url": null, "repos_url": {"github": ["https://github.com/plumenetwork"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/53623/thumb/plume-token.png?1736896935", "small": "https://coin-images.coingecko.com/coins/images/53623/small/plume-token.png?1736896935", "large": "https://coin-images.coingecko.com/coins/images/53623/large/plume-token.png?1736896935"}, "country_origin": "", "genesis_date": null, "contract_address": "0x4c1746a800d224393fe2470c70a35717ed4ea5f1", "has_supply_breakdown": false, "sentiment_votes_up_percentage": 50.0, "sentiment_votes_down_percentage": 50.0, "watchlist_portfolio_users": 24155, "market_cap_rank": 310, "market_cap_rank_with_rehypothecated": 425, "market_data": {"current_price": {"vef": 0.0012232, "btc": 1.88534e-07, "bits": 0.188534, "sats": 18.85, "eth": 6.37e-06, "ltc": 0.00025483, "bch": 5.707e-05, "bnb": 2.132e-05, "eos": 0.19404925, "xrp": 0.01107468, "xlm": 0.06808567, "link": 0.00141808, "dot": 0.01481948, "yfi": 5.77e-06, "sol": 0.00016155, "usd": 0.01221615, "aed": 0.04486382, "ars": 18.29, "aud": 0.01750165, "bdt": 1.51, "bhd": 0.00460863, "bmd": 0.01221615, "brl": 0.062197, "cad": 0.01722783, "chf": 0.00999982, "clp": 11.55, "cny": 0.08273, "czk": 0.259428, "dkk": 0.080313, "eur": 0.0