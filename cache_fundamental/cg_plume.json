ume.org/"], "whitepaper": "https://docs.plume.org/", "blockchain_site": ["https://etherscan.io/token/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://intel.arkm.com/explorer/token/plume", "https://ethplorer.io/address/0x4C1746A800D224393fE2470C70A35717eD4eA5F1", "https://bscscan.com/token/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8", "https://binplorer.com/address/0x5aFadCd1E8E3CA78Ee2D37100102f2aec8Bc0Aa8"], "official_forum_url": [], "chat_url": ["https://discord.com/invite/plume-network"], "announcement_url": [], "snapshot_url": null, "twitter_screen_name": "plumenetwork", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "plumenetwork_community", "subreddit_url": null, "repos_url": {"github": ["https://github.com/plumenetwork"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/53623/thumb/plume-token.png?1736896935", "small": "https://coin-images.coingecko.com/coins/images/53623/small/plume-token.png?1736896935", "large": "https://coin-images.coingecko.com/coins/images/53623/large/plume-token.png?1736896935"}, "country_origin": "", "genesis_date": null, "contract_address": "0x4c1746a800d224393fe2470c70a35717ed4ea5f1", "has_supply_breakdown": false, "sentiment_votes_up_percentage": 75.0, "sentiment_votes_down_percentage": 25.0, "watchlist_portfolio_users": 24169, "market_cap_rank": 300, "market_cap_rank_with_rehypothecated": 415, "market_data": {"current_price": {"vef": 0.00123633, "btc": 1.91928e-07, "bits": 0.191928, "sats": 19.19, "eth": 6.45e-06, "ltc": 0.00027388, "bch": 5.783e-05, "bnb": 2.165e-05, "eos": 0.20230888, "xrp": 0.01136512, "xlm": 0.07142896, "link": 0.00146996, "dot": 0.01624104, "yfi": 6.21e-06, "sol": 0.00016703, "usd": 0.01234725, "aed": 0.04534528, "ars": 18.52, "aud": 0.01778208, "bdt": 1.52, "bhd": 0.00464359, "bmd": 0.01234725, "brl": 0.06329, "cad": 0.01740351, "chf": 0.01011404, "clp": 11.54, "cny": 0.083565, "czk": 0.262146, "dkk": 0.080986, "eur": 0.