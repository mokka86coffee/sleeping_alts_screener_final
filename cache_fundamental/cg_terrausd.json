ious purposes, including DeFi applications , gas fees and trading. Unlike traditional fiat-backed assets, USTC’s value fluctuates based on market conditions and community participation."}, "links": {"homepage": ["https://www.terra-classic.io"], "whitepaper": "", "blockchain_site": ["https://finder.terra.money/classic/", "https://finder.terraport.finance/", "https://finder.terraclassic.community/", "https://luncscan.com/", "https://moon-runners.net/finder", "https://www.mintscan.io/osmosis/assets/ibc/aWJjL0JFMUJCNDJENEJFM0MzMEQ1MEI2OEQ3QzQxREI0REZDRTk2NzhFOEVGOEM1MzlGNkU2QTkzNDUwNDg4OTRGQ0M="], "official_forum_url": [], "chat_url": ["https://terra.sc/classicdiscord"], "announcement_url": ["https://medium.com/terra-money"], "snapshot_url": null, "twitter_screen_name": "terra_money", "facebook_username": "", "bitcointalk_thread_identifier": null, "telegram_channel_identifier": "", "subreddit_url": null, "repos_url": {"github": ["https://github.com/classic-terra/core"], "bitbucket": []}}, "image": {"thumb": "https://coin-images.coingecko.com/coins/images/12681/thumb/UST.png?1696512486", "small": "https://coin-images.coingecko.com/coins/images/12681/small/UST.png?1696512486", "large": "https://coin-images.coingecko.com/coins/images/12681/large/UST.png?1696512486"}, "country_origin": "KR", "genesis_date": null, "contract_address": "uusd", "has_supply_breakdown": false, "sentiment_votes_up_percentage": 100.0, "sentiment_votes_down_percentage": 0.0, "watchlist_portfolio_users": 51615, "market_cap_rank": 641, "market_cap_rank_with_rehypothecated": 816, "market_data": {"current_price": {"vef": 0.00053203, "btc": 8.2213e-08, "bits": 0.082213, "sats": 8.22, "eth": 2.78e-06, "ltc": 0.00011238, "bch": 2.506e-05, "bnb": 9.27e-06, "eos": 0.08435726, "xrp": 0.00481499, "xlm": 0.02956116, "link": 0.00062208, "dot": 0.00646723, "yfi": 2.5e-06, "sol": 7.056e-05, "usd": 0.00531335, "aed": 0.01951328, "ars": 7.95, "aud": 0.00761225, "bdt": 0.655607, "bhd": 0.0020045, "bmd": 0.00531335, "