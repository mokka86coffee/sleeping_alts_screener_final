# Нижняя точка шкалы семейства. Согласована со scoring.py:
# отображение 45..100 → 14..34, ниже 45 даёт отрицательный вклад.
MIN_SCORE = FLOW_MIN_SCORE

# Порог на СЫРОЙ шкале подкейса. Отдельное имя, и это принципиально:
# raw и score живут в разных шкалах, и раньше порог проверялся уже
# после приведения — то есть не проверялся вовсе.
# Нижняя граница растяжки. Порогом отбора не является — см. конфиг.
RAW_FLOOR = FLOW_RAW_FLOOR

_RUNNERS = (
    flow_hidden,
    flow_fuel,
    flow_churn,
    flow_spring,
    flow_taker,
    flow_leverage,
)

NETWORK_CASES = frozenset({"flow_leverage"})

CASE_PRIORITY = {
    "flow_hidden": 4,
    "flow_spring": 3,
    "flow_churn": 2,
    "flow_taker": 1,
    "flow_fuel": 1,
    "flow_leverage": 1,
    "none": 0,
}

CASE_CAP = {
    "flow_hidden": CAP_HIDDEN,
    "flow_spring": CAP_SPRING,
    "flow_churn": CAP_CHURN,
    "flow_taker": CAP_TAKER,
    "flow_fuel": CAP_FUEL,
    "flow_leverage": CAP_LEVERAGE,
}

TIE_MARGIN = 5
CONFIRM_BONUS = 6
CONFIRM_MIN_RAW = 35

_HEADS = {
    "flow_hidden": "Скрытый набор",
    "flow_spring": "Пружина",
    "flow_churn": "Поглощение на уровне",
    "flow_taker": "Смена агрессора",
    "flow_fuel": "Карта предложения",
    "flow_leverage": "Перекос в плече",
}

_TAILS = {
    "flow_hidden": "скрытым набором",
    "flow_spring": "сжатием",
    "flow_churn": "поглощением на уровне",
    "flow_taker": "сменой агрессора",
    "flow_fuel": "снятым предложением сверху",
    "flow_leverage": "перегруженностью шортов",
}


@dataclass
class FlowSignal:
    """Публичный сигнал семейства. Один на монету.

    Контракт с candidate.py: detected, score, case, strength_label,
    horizon_days, verdict, zone_price, stop_hint, target_hint,
    to_dict(). Поля не меняются при добавлении новых подкейсов —
    воронку править больше не нужно.
    """

    symbol: str = ""
    detected: bool = False
    score: int = 0
    case: str = "none"
    strength_label: str = ""
    horizon_days: int = 0
    horizon_tf: str = ""
    horizon_readable: bool = False

    # Уровни для построителя стратегии (Э-8). Раньше зона входа
    # оставалась внутри parts, а candidate.py её не читал: план
    # сделки строился по общей ветке, R:R выходил 1:0.0 у всех.
    zone_price: float = 0.0
    stop_hint: float = 0.0
    target_hint: float = 0.0

    cases: dict = None
    verdict: str = ""
    parts: list[dict] = field(default_factory=list)
    context: dict = field(default_factory=dict)
    # Подкейс упал: исключение, имя → тип и текст.
    failures: dict = field(default_factory=dict)
    # Подкейс отказался: фигура не собралась, имя → причина.
    #
    # Отдельно от failures намеренно. «Упал» и «посмотрел и не нашёл» —
    # разные состояния, и складывать их в одно поле значит повторить
    # ровно ту ошибку, против которой заведён раздел 0: неизвестное
    # начинает выглядеть как проверенное. Пока hidden падал на каждом
    # отказе, различить их было нельзя вообще.
    rejects: dict = field(default_factory=dict)

    def __post_init__(self) -> None:
        if self.cases is None:
            self.cases = {}

    @property
    def has_levels(self) -> bool:
        return self.zone_price > 0 and self.stop_hint > 0

    def to_dict(self) -> dict:
        return asdict(self)


# ─────────────────────────────────────────────────────────────
# Загрузка баров
# ─────────────────────────────────────────────────────────────
def _load_bars(symbol: str) -> list[Bar]:
    """Дневки Binance → бары ядра.

    Заполнение последнего бара считается ПО ВРЕМЕНИ, а не по факту
    присутствия в ряду. Иначе величина вырождается в константу:
    последний бар есть всегда, и вся ветка нормировки неполного бара
    становится мёртвой, внешне неотличимой от рабочей.
    """
    raw = klines_1d(symbol)
    if not raw:
        return []

    import time
    now_ms = time.time() * 1000.0

    out: list[Bar] = []
    for k in raw:
        try:
            o = float(k[K_OPEN])
            h = float(k[K_HIGH])
            lo = float(k[K_LOW])
            c = float(k[K_CLOSE])
            quote = float(k[K_QUOTE_VOLUME])
            buy = float(k[K_TAKER_BUY_QUOTE])
            t_open = float(k[K_OPEN_TIME])
            t_close = float(k[K_CLOSE_TIME])
        except (TypeError, ValueError, IndexError):
            continue

        if c <= 0 or quote <= 0:
            continue

        span = t_close - t_open
        if span > 0 and now_ms < t_close:
            fill = max(0.0, min(1.0, (now_ms - t_open) / span))
        else:
            fill = 1.0

        buy = min(buy, quote)
        out.append(
            Bar(
                ts=int(t_open),
                open=o,
                high=h,
                low=lo,
                close=c,
                volume=quote,
                buy_volume=buy,
                sell_volume=max(0.0, quote - buy),
                fill=fill,
            )
        )

    return out


# ─────────────────────────────────────────────────────────────
# Горизонт
# ─────────────────────────────────────────────────────────────
def _horizon(ctx: FlowContext) -> dict:
    """Самый крупный масштаб, на котором картина ещё читается.

    Не про силу сигнала, а про то, сколько ждать. В скор не входит.

    Масштаб засчитывается, только если даёт существенный прирост
    амплитуды против базового ряда той же монеты. Случайное блуждание
    расширяет бар как корень масштаба; прирост в пределах этого не
    проявляет ничего нового и лишь удлиняет ожидание.
    """
    base = ctx.by_scale.get(1) or ctx.bars
    if len(base) < 10:
        return {"wait_days": 0, "label": "дни", "readable": False, "scale": 1}

    tail = base[-30:]
    shares = [b.range / b.close for b in tail if b.close > 0]
    if not shares:
        return {"wait_days": 0, "label": "дни", "readable": False, "scale": 1}

    base_amp = sorted(shares)[len(shares) // 2]
    if base_amp <= 0:
        return {"wait_days": 0, "label": "дни", "readable": False, "scale": 1}

    best_scale = 1
    for scale in sorted(ctx.by_scale):
        if scale <= 1:
            continue
        bars = ctx.by_scale[scale]
        chunk = bars[-30:]
        if len(chunk) < 10:
            continue
        vals = [b.range / b.close for b in chunk if b.close > 0]
        if not vals:
            continue
        amp = sorted(vals)[len(vals) // 2]
        if amp >= base_amp * math.sqrt(scale) * HORIZON_AMP_GAIN:
            best_scale = scale

    days = int(best_scale * HORIZON_BARS_AHEAD)
    if days <= 3:
        label = "дни"
    elif days <= 10:
        label = "неделя"
    elif days <= 25:
        label = "недели"
    else:
        label = "месяц+"

    return {
        "wait_days": max(1, days),
        "label": label,
        "readable": best_scale > 1,
        "scale": best_scale,
    }


# ─────────────────────────────────────────────────────────────
# Сериализация контекста
# ─────────────────────────────────────────────────────────────
def _context_dict(ctx: FlowContext, hz: dict) -> dict:
    """Срез контекста для отчёта.

    Зоны отдаются ПОЛНОСТЬЮ, без фильтра по confirmed и без среза:
    подкейсы работают со всей картой, и срез обязан показывать ту же,
    иначе диагностика ложная. Признак confirmed остаётся внутри
    каждой зоны — фильтровать по нему должен читатель.

    fills — состояние ИЗМЕРИТЕЛЯ, а не рынка. Именно отсутствие этого
    поля держало мёртвой всю ветку неполного бара: величина, от
    которой зависел расчёт, нигде не показывалась.
    """
    return {
        "price": round(ctx.price, 10),
        "scales": sorted(ctx.by_scale),
        "fills": {
            scale: round(bars[-1].fill, 3)
            for scale, bars in sorted(ctx.by_scale.items())
            if bars
        },
        "events_total": len(ctx.events),
        "zones": [
            {
                "price": round(z.price, 10),
                "events": len(z.events),
                "scales": sorted(z.scales),
                "confirmed": z.confirmed,
                "tier_sum": z.tier_sum,
                "absorbed_ratio": round(z.absorbed_ratio, 2),
                "strength": round(z.strength, 2),
                "tests": z.tests,
                "plateau": z.plateau,
                "broken": z.broken,
            }
            for z in ctx.zones
        ],
        "zones_confirmed": sum(1 for z in ctx.zones if z.confirmed),
        "flow": {
            "slope": round(ctx.flow.slope, 4),
            "homogeneity": round(ctx.flow.homogeneity, 3),
            "net": round(ctx.flow.net, 2),
            "accumulating": ctx.flow.accumulating,
            "distributing": ctx.flow.distributing,
            # Наклон дельты и вывод из него.
            #
            # Обе величины вместе намеренно: collapsing — это
            # delta_slope, сравнённый с DELTA_COLLAPSE_SLOPE, и по
            # булеву не видно, монета далеко за порогом или стоит на
            # нём. Пока поля не было, разброс приходилось собирать из
            # текстов причин отказа — а они есть только у тех, кто
            # отказал, то есть выборка обрезана сверху.
            "delta_slope": round(ctx.flow.delta_slope, 5),
            "collapsing": ctx.flow.collapsing,
            "buy_share": round(ctx.flow.buy_share, 4),
        },
        "vortex": {
            "scale": ctx.vortex.scale,
            "direction": ctx.vortex.direction,
            "strength": round(ctx.vortex.strength, 3),
            "extrema": ctx.vortex.extrema,
            "sell_peaks": ctx.vortex.sell_peaks,
            "buy_lows": ctx.vortex.buy_lows,
            "mult": round(ctx.vortex.multiplier, 3),
        },
        "drop": {
            "drop_pct": round(ctx.drop.drop_pct * 100, 1),
            "bars_since_bottom": ctx.drop.bars_since_bottom,
            "distrust_zones": ctx.drop.distrust_zones,
            # growth_x и peak_age_days читает fuel, наружу не отдавал
            # никто. Окно DropContext — 240 дней против 14 у журнала
            # лидеров, и признак «первый разгон после ЭТОГО падения»
            # выводится отсюда. Формула не выбрана, разброс нужен
            # раньше выбора.
            "growth_x": round(ctx.drop.growth_x, 2),
            "peak_age_days": ctx.drop.peak_age_days,
            "deep": ctx.drop.deep,
            "fresh": ctx.drop.fresh,
        },
        "rel_vol": round(ctx.rel_vol, 2),
        "atr_share": round(ctx.atr_share, 4),
        "horizon": hz["label"],
    }


# ─────────────────────────────────────────────────────────────
# Скор и вердикт
# ─────────────────────────────────────────────────────────────
def _strength(score: int) -> str:
    if score >= 85:
        return "экстремальный"
    if score >= 70:
        return "сильный"
    if score >= MIN_SCORE:
        return "умеренный"
    return ""


# Верх растяжки. Сотня была фикцией: подкейс упирается в свой CASE_CAP
# задолго до неё, и по замеру 174 монет наблюдаемый максимум сырого
# скора равен 61.4 при медиане 38. Растягивая до ста, мы отдавали
# верхнюю треть шкалы семейства под значения, которые не приходят —
# итоговые скоры жались в 49..73 из доступных 45..100.
RAW_CEIL = 75.0


def _to_family_score(raw: float) -> int:
    """Приводит сырую шкалу подкейса к шкале семейства 45..100.

    Отображается диапазон, который реально приходит: RAW_FLOOR..RAW_CEIL.
    Обе границы взяты из замера, а не из вида шкалы 0..100 — иначе
    половина выходного диапазона не используется, и разница между
    средней фигурой и сильной сжимается до нескольких баллов.
    """
    raw = max(RAW_FLOOR, min(RAW_CEIL, raw))
    span_raw = RAW_CEIL - RAW_FLOOR
    span_out = FLOW_MAX_SCORE - MIN_SCORE
    if span_raw <= 0:
        return MIN_SCORE
    return int(round(MIN_SCORE + (raw - RAW_FLOOR) * span_out / span_raw))


def _verdict(name: str, sig: SubcaseSignal, confirmed_by: str = "") -> str:
    head = _HEADS.get(name, "Поток")
    if not sig.reasons:
        text = f"{head}."
    else:
        text = f"{head}: {'; '.join(sig.reasons[:3])}."
    if confirmed_by:
        tail = _TAILS.get(confirmed_by, "вторым подкейсом")
        text += f" Подтверждено {tail}."
    return text


def _levels(ctx: FlowContext, sig: SubcaseSignal) -> tuple[float, float, float]:
    """Зона входа, стоп и первая цель (Э-8).

    Вход — уровень фигуры, найденный подкейсом. Стоп — под ближайшей
    опорой, а если её нет, отступ от зоны на долю ATR. Цель — ближайший
    завал сверху: именно там встретится предложение.
    """
    from detectors.flow_config import (
        FLOW_STOP_PCT,
        FLOW_TARGET_FALLBACK_PCT,
    )

    entry = float(getattr(sig, "zone_price", 0.0) or 0.0)
    if entry <= 0:
        entry = ctx.price
    if entry <= 0:
        return 0.0, 0.0, 0.0

    support = ctx.nearest_below()
    if support is not None and 0 < support.price < entry:
        stop = support.price * (1.0 - FLOW_STOP_PCT)
    else:
        stop = entry * (1.0 - FLOW_STOP_PCT)

    resist = ctx.nearest_above()
    if resist is not None and resist.price > entry:
        target = resist.price
    else:
        target = entry * (1.0 + FLOW_TARGET_FALLBACK_PCT)

    return entry, stop, target


# ─────────────────────────────────────────────────────────────
# Точка входа
# ─────────────────────────────────────────────────────────────
def detect_flow(
    symbol: str,
    quote_volume_24h: float = 0.0,
    allow_network: bool = True,
) -> FlowSignal:
    """Прогоняет подкейсы по общему контексту и возвращает сильнейший.

    Контекст считается ОДИН раз: дневки берутся из RunCache, агрегаты
    строятся из них, поэтому масштабы бесплатны.

    allow_network выключает подкейсы, которым нужны funding и OI: два
    лишних запроса на монету при двухстах монетах — это минуты, а на
    выводы о зонах и событиях они не влияют.
    """
    bars = _load_bars(symbol)
    if len(bars) < MIN_BARS:
        return FlowSignal(symbol=symbol)

    ctx = build_context(symbol, bars)
    if ctx is None or not ctx.ready:
        return FlowSignal(symbol=symbol)

    # Ноль от вызывающего означает «не передавали», а не «оборота нет».
    # Прямое присваивание затирало величину, уже посчитанную ядром,
    # и фильтр ликвидности снимал все монеты подряд.
    if quote_volume_24h > 0:
        ctx.quote_volume_24h = quote_volume_24h

    hz = _horizon(ctx)
    ctx_dict = _context_dict(ctx, hz)

    results: list[tuple[str, SubcaseSignal]] = []
    failures: dict[str, str] = {}

    for module in _RUNNERS:
        # __name__ у импортированного модуля полный: "detectors.flow_leverage".
        # Сравнение с NETWORK_CASES по нему всегда ложно, и allow_network
        # молча перестаёт действовать.
        mod_name = getattr(module, "name", module.__name__.rsplit(".", 1)[-1])

        if not allow_network and mod_name in NETWORK_CASES:
            continue

        try:
            sig = module.detect(ctx)
        except Exception as exc:
            # Падение одного подкейса не должно ронять семейство.
            # Но и терять ошибку молча нельзя: неработающий модуль
            # выглядит как модуль, которому нечего сказать.
            failures[mod_name] = f"{type(exc).__name__}: {exc}"
            continue

        if sig is None:
            continue

        cap = CASE_CAP.get(sig.subcase)
        if cap is None:
            failures[mod_name] = (
                f"нет потолка для subcase={sig.subcase!r}; "
                f"ожидались {sorted(CASE_CAP)}"
            )
            cap = min(CASE_CAP.values())

        if sig.score > cap:
            sig.score = float(cap)

        results.append((sig.subcase, sig))

    # Причины отказов накопились в контексте: он один на монету и
    # переживает всех подкейсов, в отличие от их возвращаемых значений.
    rejects = dict(ctx.notes)

    cases = {
        name: {
            "score": round(sig.score, 1),
            "base": round(sig.base_score, 1),
            "cut": round(sig.cut, 2),
            "reasons": sig.reasons[:3],
            "mults": sig.mults,
        }
        for name, sig in results
    }

    if not results:
        return FlowSignal(
            symbol=symbol,
            cases={},
            context=ctx_dict,
            failures=failures,
            rejects=rejects,
        )

    # ── Победитель ───────────────────────────────────────────
    # Двухпроходный выбор — необходимость, а не стиль: отношение
    # предпочтения не транзитивно, и однопроходный цикл сделал бы
    # исход зависимым от порядка модулей в _RUNNERS.
    top_score = max(s.score for _, s in results)
    contenders = [(n, s) for n, s in results if s.score >= top_score - TIE_MARGIN]
    best_name, best_sig = max(
        contenders,
        key=lambda x: (CASE_PRIORITY.get(x[0], 0), x[1].score),
    )

    raw = best_sig.score

    # ── Подтверждение вторым подкейсом ───────────────────────
    confirmed_by = ""
    others = [
        (n, s) for n, s in results
        if n != best_name and s.score >= CONFIRM_MIN_RAW
    ]
    if others:
        confirmed_by = max(others, key=lambda x: x[1].score)[0]
        cap = CASE_CAP.get(best_name, 100)
        raw = min(float(cap), raw + CONFIRM_BONUS)

    score = _to_family_score(raw)
    entry, stop, target = _levels(ctx, best_sig)

    verdict = _verdict(best_name, best_sig, confirmed_by)

    return FlowSignal(
        symbol=symbol,
        detected=True,
        score=score,
        case=best_name,
        strength_label=_strength(score),
        horizon_days=hz["wait_days"],
        horizon_tf=hz["label"],
        horizon_readable=hz["readable"],
        zone_price=entry,
        stop_hint=stop,
        target_hint=target,
        cases=cases,
        verdict=verdict,
        parts=[
            {
                "zone_price": entry,
                "stop_hint": stop,
                "target_hint": target,
                "confirmed_by": confirmed_by,
                "reasons": best_sig.reasons,
                "facts": getattr(best_sig, "facts", {}),
                "mults": best_sig.mults,
            }
        ],
        context=ctx_dict,
        failures=failures,
        rejects=rejects,
    )
