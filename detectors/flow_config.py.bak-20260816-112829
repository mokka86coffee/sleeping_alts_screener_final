# ─────────────────────────────────────────────────────────────
# flow_leverage
# ─────────────────────────────────────────────────────────────
# ВНИМАНИЕ: значения ниже НЕ откалиброваны. Подкейс не работал ни
# разу в этой редакции (импорт валился), поэтому наблюдённого
# разброса по рынку для него не существует — в отличие от долей
# покупок или наклона дельты, где пороги ставились по замерам.
#
# Порядок работы с ними — тот же, что вытащил churn: сначала прогон
# flow_probe с заведомо мягкими границами, потом сужение по
# распределению. Ставить сразу строго нельзя: именно так churn
# получил порог выше рыночного максимума и семь месяцев не мог
# сработать ни разу, а значит и калиброваться было не на чем.

# Требовать сработавшее дневное ядро (живые зоны) до сетевых
# запросов. Выключение сделает подкейс дорогим, смысла нет.
LEV_REQUIRE_CORE = True

# ── Фандинг ──
# Все пороги в ГОДОВЫХ процентах: сырая ставка не сравнима между
