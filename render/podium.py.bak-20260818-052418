.obp-art{position:absolute;left:0;right:0;bottom:74px;height:126px}
.obp-art svg{display:block;width:100%;height:100%}

/* ── Приборы ─────────────────────────────────────────────────
   Три величины — три формы, а не четыре одинаковых числа в строку.
